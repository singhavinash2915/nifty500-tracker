# Web app — anon key only. RLS makes every table read-only from the browser
# except watchlist / positions / alerts.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# The single account the positions page signs in as. Not a secret — the
# password is what gates anything — but the sign-in form needs to know which
# account it is asking about so you only have to type one field.
VITE_OWNER_EMAIL=you@example.com
