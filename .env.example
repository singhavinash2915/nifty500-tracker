# Ingestion (Python) — service-role key, never exposed to the browser
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# Blend weights. Defaults are 25 / 35 / 40 — see config.py for why the quality
# weight was cut from the plan's 45.
# WEIGHT_QUALITY=25
# WEIGHT_VALUE=35
# WEIGHT_TECHNICAL=40

# Optional HTTP tuning for the fetchers
HTTP_TIMEOUT=30
# HTTP_USER_AGENT=
